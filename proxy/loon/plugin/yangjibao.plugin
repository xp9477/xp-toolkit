[Script]

# 拦截账户接口 - 伪装VIP状态
http-response ^https?:\/\/app-api\.yangjibao\.com\/users\/v1\/account script-path=https://raw.githubusercontent.com/xp9477/xp-toolkit/main/proxy/loon/script/yangjibao-vip.js, requires-body=true, timeout=10

[MITM]
hostname = app-api.yangjibao.com
