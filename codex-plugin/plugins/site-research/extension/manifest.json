{
  "manifest_version": 3,
  "name": "XP Site Research · 本机只读桥接",
  "version": "0.1.0",
  "description": "让本机 Codex 使用本人 Linux.do 浏览器登录进行只读检索，不导出 Cookie。",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://linux.do/*", "http://127.0.0.1:47831/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "设置 Site Research 浏览器桥接" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
